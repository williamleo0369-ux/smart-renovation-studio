{
  "expo": {
    "name": "空间焕新",
    "slug": "smart-renovation-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "QUCZ5655D9",
      "bundleIdentifier": "app.rork.smart-renovation-studio",
      "buildNumber": "4",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "用于选择您主动上传的空间照片并生成改造创意参考图。",
        "NSCameraUsageDescription": "用于拍摄您希望进行改造设计的空间照片。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.smart_renovation_studio"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择您主动上传的空间照片并生成改造创意参考图。",
          "cameraPermission": "用于拍摄您希望进行改造设计的空间照片。"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
